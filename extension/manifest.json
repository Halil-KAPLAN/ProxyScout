{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShort__",
  "version": "1.2.2",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://github.com/Halil-KAPLAN/ProxyScout",
  "minimum_chrome_version": "116",
  "permissions": [
    "proxy",
    "storage",
    "unlimitedStorage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extShort__",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png",
      "48": "icons/off48.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/brand16.png",
    "32": "icons/brand32.png",
    "48": "icons/brand48.png",
    "128": "icons/brand128.png"
  }
}
